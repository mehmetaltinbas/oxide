{
    "name": "oxide",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "prettier --check . && tsc --noEmit && vite build",
        "preview": "vite preview",
        "server": "node server/index.mjs",
        "dev:all": "node server/index.mjs & vite",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "prettier --check . && tsc --noEmit"
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "typescript": "^5.6.3",
        "vite": "^5.4.10"
    },
    "dependencies": {
        "ws": "^8.21.3"
    }
}
